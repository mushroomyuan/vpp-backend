  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["vpp", "loki", "logs"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": ".*" },
        "includeAll": true,
        "label": "Service",
        "multi": false,
        "name": "service",
        "options": [
          { "selected": true, "text": "All", "value": ".*" },
          { "selected": false, "text": "resource", "value": "resource" },
          { "selected": false, "text": "telemetry", "value": "telemetry" },
          { "selected": false, "text": "gateway", "value": "gateway" },
          { "selected": false, "text": "dispatch", "value": "dispatch" },
          { "selected": false, "text": "simulator", "value": "simulator" }
        ],
        "query": "resource,telemetry,gateway,dispatch,simulator",
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
