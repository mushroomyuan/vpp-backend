      "targets": [
        {
          "expr": "{job=\"vpp\", service=~\"$service\"} | json | trace_id != \"\"",
          "refId": "A"
        }
      ],
      "title": "Recent Traced Logs (click TraceID → Jaeger)",
      "type": "logs"
