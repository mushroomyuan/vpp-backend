{
  "swagger": "2.0",
  "info": {
    "title": "common.proto",
    "version": "version not set"
  },
  "tags": [
    {
      "name": "TelemetryService",
      "description": "TelemetryService exposes APIs for ingesting, querying, and aggregating\ntime-series telemetry data from Control Units (CUs).\n\nWrite path:  IngestTelemetry (saves to TSDB + updates real-time Snapshot + publishes SOE)\nRead paths:\n  - QueryTelemetry    — raw historical records (≤ 30-day window)\n  - GetSnapshot       — current real-time state of a single CU\n  - GetSnapshots      — current state for an explicit CU list and metric set\n  - GetFleetSnapshot  — current real-time state of all CUs in a tenant\n  - QueryAggregation  — downsampled/aggregated time-series (≤ 30-day window)"
    }
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/tenants/{TenantID}/cus/{CUCode}/aggregation": {
      "get": {
        "summary": "QueryAggregation returns downsampled time-series data for a single CU metric.\nThe storage engine (TimescaleDB / InfluxDB) handles the aggregation natively.\nThe time range must not exceed 30 days.",
        "operationId": "TelemetryService_QueryAggregation",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/telemetrypbQueryAggregationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "TenantID",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "CUCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "MetricID",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "StartTime",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "EndTime",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "StepSeconds",
            "description": "StepSeconds is the downsampling window size in seconds.\ne.g. 60 = 1-minute buckets, 900 = 15-minute buckets.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "Functions",
            "description": "Functions lists which aggregation functions to compute (at least one required).\n\n - AGG_FUNCTION_SUM: AGG_FUNCTION_SUM is useful for energy (kWh) accumulation over a window.\n - AGG_FUNCTION_COUNT: AGG_FUNCTION_COUNT is useful for counting discrete state transitions.\n - AGG_FUNCTION_LAST: AGG_FUNCTION_LAST returns the most recent sample within the window.",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "AGG_FUNCTION_UNSPECIFIED",
                "AGG_FUNCTION_AVG",
                "AGG_FUNCTION_MAX",
                "AGG_FUNCTION_MIN",
                "AGG_FUNCTION_SUM",
                "AGG_FUNCTION_COUNT",
                "AGG_FUNCTION_LAST"
              ]
            },
            "collectionFormat": "multi"
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    },
    "/api/tenants/{TenantID}/cus/{CUCode}/snapshot": {
      "get": {
        "summary": "GetSnapshot returns the latest real-time snapshot for a single CU.\nReturns NOT_FOUND if no data has been ingested for the CU yet.",
        "operationId": "TelemetryService_GetSnapshot",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/telemetrypbSnapshot"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "TenantID",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "CUCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "StaleAgeSeconds",
            "description": "StaleAgeSeconds overrides the server-side default (300 s / 5 min).\nPass 0 to use the default.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    },
    "/api/tenants/{TenantID}/cus/{CUCode}/telemetry": {
      "get": {
        "summary": "QueryTelemetry returns raw historical records for a single CU metric.\nThe time range must not exceed 30 days.",
        "operationId": "TelemetryService_QueryTelemetry",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/telemetrypbQueryTelemetryResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "TenantID",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "CUCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "MetricID",
            "description": "MetricID filters results to a single canonical metric; omit to return all metrics.",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "StartTime",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          },
          {
            "name": "EndTime",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "date-time"
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    },
    "/api/tenants/{TenantID}/cus/{CUCode}/telemetry:ingest": {
      "post": {
        "summary": "IngestTelemetry ingests a single CU's metric readings for one timestamp.\nCallers should invoke this once per CU per sampling cycle.",
        "operationId": "TelemetryService_IngestTelemetry",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/telemetrypbIngestTelemetryResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "TenantID",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "CUCode",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/TelemetryServiceIngestTelemetryBody"
            }
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    },
    "/api/tenants/{TenantID}/snapshots": {
      "get": {
        "summary": "GetFleetSnapshot returns real-time snapshots for every CU in a tenant.\nUsed by dashboards and fleet-level staleness checks.",
        "operationId": "TelemetryService_GetFleetSnapshot",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/telemetrypbGetFleetSnapshotResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "TenantID",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "StaleAgeSeconds",
            "description": "StaleAgeSeconds overrides the server-side default (300 s / 5 min).\nPass 0 to use the default.",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    },
    "/api/tenants/{TenantID}/snapshots:batch": {
      "get": {
        "summary": "GetSnapshots returns real-time snapshots for the requested CUs and metric IDs.\nDecision uses this instead of scanning the tenant fleet.",
        "operationId": "TelemetryService_GetSnapshots",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/telemetrypbGetSnapshotsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "TenantID",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "CUCodes",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "MetricIDs",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "StaleAgeSeconds",
            "description": "StaleAgeSeconds overrides the server-side default (300 s / 5 min).\nPass 0 to use the default. It only affects Snapshot.Stale (CU-level).",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "TelemetryService"
        ]
      }
    }
  },
  "definitions": {
    "TelemetryServiceIngestTelemetryBody": {
      "type": "object",
      "properties": {
        "Timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "Metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbMetricValue"
          }
        }
      },
      "description": "IngestTelemetryRequest carries one push from a single CU: one timestamp and\nN metric readings. Callers should invoke this RPC once per CU per sampling cycle."
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "telemetrypbAggFunction": {
      "type": "string",
      "enum": [
        "AGG_FUNCTION_UNSPECIFIED",
        "AGG_FUNCTION_AVG",
        "AGG_FUNCTION_MAX",
        "AGG_FUNCTION_MIN",
        "AGG_FUNCTION_SUM",
        "AGG_FUNCTION_COUNT",
        "AGG_FUNCTION_LAST"
      ],
      "default": "AGG_FUNCTION_UNSPECIFIED",
      "description": "AggFunction specifies which statistical function to compute over a time window.\n\n - AGG_FUNCTION_SUM: AGG_FUNCTION_SUM is useful for energy (kWh) accumulation over a window.\n - AGG_FUNCTION_COUNT: AGG_FUNCTION_COUNT is useful for counting discrete state transitions.\n - AGG_FUNCTION_LAST: AGG_FUNCTION_LAST returns the most recent sample within the window."
    },
    "telemetrypbAggregatedPoint": {
      "type": "object",
      "properties": {
        "CUCode": {
          "type": "string"
        },
        "MetricID": {
          "type": "string"
        },
        "WindowStart": {
          "type": "string",
          "format": "date-time"
        },
        "WindowEnd": {
          "type": "string",
          "format": "date-time"
        },
        "Avg": {
          "type": "number",
          "format": "double"
        },
        "Max": {
          "type": "number",
          "format": "double"
        },
        "Min": {
          "type": "number",
          "format": "double"
        },
        "Sum": {
          "type": "number",
          "format": "double",
          "description": "Sum is useful for energy (kWh) accumulation."
        },
        "Count": {
          "type": "string",
          "format": "int64",
          "description": "Count is useful for counting discrete state transitions."
        },
        "Last": {
          "type": "number",
          "format": "double",
          "description": "Last is the most recent sample value within the window."
        }
      },
      "description": "AggregatedPoint holds the result of applying one or more AggFunctions over a\nsingle step-sized window. Optional fields are absent when the function was not\nrequested or when the window contained no samples."
    },
    "telemetrypbGetFleetSnapshotResponse": {
      "type": "object",
      "properties": {
        "Snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbSnapshot"
          }
        }
      }
    },
    "telemetrypbGetSnapshotsResponse": {
      "type": "object",
      "properties": {
        "Snapshots": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbSnapshot"
          },
          "description": "Snapshots follows the request CU order. CUs with no stored snapshot are omitted.\nA returned snapshot contains only the requested metric IDs that are present."
        }
      }
    },
    "telemetrypbIngestTelemetryResponse": {
      "type": "object",
      "properties": {
        "SOECount": {
          "type": "integer",
          "format": "int32",
          "description": "SOECount is the number of discrete state-change events produced by this push."
        }
      }
    },
    "telemetrypbMetricState": {
      "type": "object",
      "properties": {
        "MetricID": {
          "type": "string"
        },
        "DoubleValue": {
          "type": "number",
          "format": "double"
        },
        "ObservedAt": {
          "type": "string",
          "format": "date-time"
        },
        "Quality": {
          "$ref": "#/definitions/telemetrypbQualityStatus"
        }
      },
      "description": "MetricState is the latest sample of one canonical numeric metric.\ndouble_value is the only value representation this round. Later Int/Bool/Enum\nsupport must add new fields and leave double_value in place."
    },
    "telemetrypbMetricType": {
      "type": "string",
      "enum": [
        "METRIC_TYPE_UNSPECIFIED",
        "METRIC_TYPE_ANALOG",
        "METRIC_TYPE_DISCRETE"
      ],
      "default": "METRIC_TYPE_UNSPECIFIED",
      "description": "MetricType distinguishes continuous measurements from discrete state values,\naligned with IEC 60870-5 terminology.\n\n - METRIC_TYPE_ANALOG: METRIC_TYPE_ANALOG: a continuous physical measurement (power, voltage, SOC…)\n - METRIC_TYPE_DISCRETE: METRIC_TYPE_DISCRETE: a finite-state signal (breaker, relay, fault flag…)\nState changes in DISCRETE metrics trigger SOE events."
    },
    "telemetrypbMetricValue": {
      "type": "object",
      "properties": {
        "MetricID": {
          "type": "string"
        },
        "Value": {
          "type": "number",
          "format": "double"
        },
        "Type": {
          "$ref": "#/definitions/telemetrypbMetricType"
        },
        "Quality": {
          "$ref": "#/definitions/telemetrypbQualityStatus"
        }
      },
      "description": "MetricValue is a single measured data point within a telemetry push.\nMetricID must be a numeric canonical metric from the shared contract registry."
    },
    "telemetrypbQualityStatus": {
      "type": "string",
      "enum": [
        "QUALITY_STATUS_UNSPECIFIED",
        "QUALITY_STATUS_GOOD",
        "QUALITY_STATUS_BAD",
        "QUALITY_STATUS_UNCERTAIN"
      ],
      "default": "QUALITY_STATUS_UNSPECIFIED",
      "description": "QualityStatus follows the IEC 60870-5 / OPC-UA data quality convention."
    },
    "telemetrypbQueryAggregationResponse": {
      "type": "object",
      "properties": {
        "Points": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbAggregatedPoint"
          }
        }
      }
    },
    "telemetrypbQueryTelemetryResponse": {
      "type": "object",
      "properties": {
        "Records": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbTelemetryRecord"
          }
        }
      }
    },
    "telemetrypbSnapshot": {
      "type": "object",
      "properties": {
        "TenantID": {
          "type": "string"
        },
        "CUCode": {
          "type": "string"
        },
        "Metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbMetricState"
          }
        },
        "UpdatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "UpdatedAt is the timestamp of the latest ingest applied to this CU."
        },
        "Stale": {
          "type": "boolean",
          "description": "Stale is true when UpdatedAt is older than the requested StaleAgeSeconds\nthreshold (or the server default of 5 minutes). Per-metric freshness is\nObservedAt on each MetricState."
        }
      },
      "description": "Snapshot holds the latest per-metric state for a single CU.\nEach metric keeps its own value, observation time, and quality. A bad or\nuncertain sample replaces the previous state instead of leaving an older\ngood value in place."
    },
    "telemetrypbTelemetryRecord": {
      "type": "object",
      "properties": {
        "TenantID": {
          "type": "string"
        },
        "CUCode": {
          "type": "string"
        },
        "Timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "Metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/telemetrypbMetricValue"
          }
        }
      },
      "description": "TelemetryRecord is the read model for a single raw time-series entry."
    }
  }
}
