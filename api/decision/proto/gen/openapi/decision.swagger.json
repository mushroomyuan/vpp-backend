  "tags": [
    {
      "name": "DecisionService",
      "description": "DecisionService manages tenant policies. Objective and plan RPCs are not\npart of this service yet.\n\nEnablePolicy calls Resource ResolveScope before the row is marked enabled.\nAn active storage CU that lacks a valid energy.storage.v1 spec, a SOC read\nbinding, or an active-power setpoint write binding fails the call and\nleaves the policy disabled."
    }
  ],
