          "type": "string",
          "format": "int64"
        }
      }
    },
    "DecisionServiceUpdatePolicyBody": {
      "type": "object",
      "properties": {
        "Version": {
          "type": "string",
          "format": "int64"
        },
        "Name": {
          "type": "string"
        },
        "Scope": {
          "$ref": "#/definitions/decisionpbTargetScope"
        },
        "Cooldown": {
          "type": "string"
        },
        "SOC": {
          "$ref": "#/definitions/decisionpbSOCThresholdSpec"
        }
      },
      "description": "UpdatePolicy replaces name, scope, cooldown, and the SOC spec.\nKind and Enabled stay as stored. Enabled policies are prechecked again\nagainst the new scope and spec; a failed precheck does not write."
    },
    "decisionpbListPoliciesResponse": {
      "type": "object",
      "properties": {
        "Policies": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/decisionpbPolicy"
          }
        }
      }
    },
    "decisionpbPolicy": {
      "type": "object",
      "properties": {
        "ID": {
          "type": "string"
        },
        "TenantID": {
          "type": "string"
        },
        "Name": {
          "type": "string"
        },
        "Kind": {
          "$ref": "#/definitions/decisionpbPolicyKind"
        },
        "Scope": {
          "$ref": "#/definitions/decisionpbTargetScope"
        },
        "Enabled": {
          "type": "boolean"
        },
        "Cooldown": {
          "type": "string",
          "description": "Zero means the process default cooldown. It does not disable cooldown."
        },
        "Version": {
          "type": "string",
          "format": "int64",
          "description": "Version starts at 1. Update, Enable, and Disable send the version they read."
        },
        "SOC": {
          "$ref": "#/definitions/decisionpbSOCThresholdSpec"
        },
        "CreatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "UpdatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "CreatedBy": {
          "type": "string"
        },
        "UpdatedBy": {
          "type": "string"
        }
      }
    },
    "decisionpbPolicyKind": {
      "type": "string",
      "enum": [
        "POLICY_KIND_UNSPECIFIED",
        "POLICY_KIND_SOC_THRESHOLD"
      ],
      "default": "POLICY_KIND_UNSPECIFIED"
    },
    "decisionpbSOCThresholdSpec": {
      "type": "object",
      "properties": {
        "MinSOC": {
          "type": "number",
          "format": "double"
        },
        "MaxSOC": {
          "type": "number",
          "format": "double"
        },
        "ChargePowerKW": {
          "type": "number",
          "format": "double"
        },
        "DischargePowerKW": {
          "type": "number",
          "format": "double"
        }
      },
      "description": "SOCThresholdSpec is the typed body of a SOC threshold policy.\nPowers are positive scope totals in canonical kW."
    },
    "decisionpbScopeType": {
      "type": "string",
      "enum": [
        "SCOPE_TYPE_UNSPECIFIED",
        "SCOPE_TYPE_SITE",
        "SCOPE_TYPE_ASSET",
        "SCOPE_TYPE_CU"
      ],
      "default": "SCOPE_TYPE_UNSPECIFIED"
    },
    "decisionpbTargetScope": {
      "type": "object",
      "properties": {
        "Type": {
          "$ref": "#/definitions/decisionpbScopeType"
        },
        "ID": {
          "type": "string"
        }
      }
    },
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
