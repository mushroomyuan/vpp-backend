  "models": [
    {
      "owner": "default",
      "name": "vpp-rbac",
      "createdTime": "2026-01-01T00:00:00Z",
      "displayName": "VPP RBAC",
      "description": "Shared Casbin model for local PDP (AUTHZ C5); see conf/authz_model.conf",
      "modelText": "# VPP shared Casbin model (C5).\n# Used by Casdoor Model seed and by each service's local Enforcer (C6+).\n#\n# Request:  sub = VPP role name (admin|operator|viewer|\u2026), obj = catalog resource, act = action\n# Catalog:  {service}:{resource}  +  {action}  \u2192  full id {service}:{resource}:{action}\n# Example:  (operator, resource:sites, write)\n#\n# keyMatch2 lets Casdoor/local policies use wildcards (e.g. resource:*).\n# Role inheritance (g) is optional; Syncer may load Casdoor nested roles later.\n\n[request_definition]\nr = sub, obj, act\n\n[policy_definition]\np = sub, obj, act\n\n[role_definition]\ng = _, _\n\n[policy_effect]\ne = some(where (p.eft == allow))\n\n[matchers]\nm = g(r.sub, p.sub) && keyMatch2(r.obj, p.obj) && r.act == p.act\n"
    }
  ],
